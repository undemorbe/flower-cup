# Скопируйте в server/.env (он в .gitignore) и заполните. Запуск: node --env-file=server/.env server/index.js
PORT=8787
HOST=127.0.0.1
DATA_DIR=server/data

# npm run admin:hash
ADMIN_PASSWORD_HASH=
# openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=12

# С каких сайтов можно заходить в админку (через запятую, без слеша в конце)
ALLOWED_ORIGINS=https://undemorbe.github.io,http://localhost:5183

# 1 - если перед сервером стоит nginx/Caddy и он передаёт X-Forwarded-For
TRUST_PROXY=0

# Необязательно: пересобирать сайт на GitHub Pages после правок
# Токен fine-grained, доступ только к этому репозиторию, право Actions: write
GITHUB_TOKEN=
GITHUB_REPO=undemorbe/flower-cup
GITHUB_WORKFLOW=deploy.yml
GITHUB_REF=main
REBUILD_DELAY_SEC=120
